@using Blazored.LocalStorage
@using Care.Wasm.Client.Components
@using Care.Wasm.Client.Infrastructure.Auth
@using Care.Wasm.Client.Infrastructure.ApiClient
@inject IAuthenticationService AuthService
@inject ISettingsClient SettingsClient
@inject IUsersClient UsersClient
@inject ILocalStorageService LocalStorage
@inject IDialogService DialogService

<MudAppBar Elevation="0">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
    <MudText Typo="Typo.h6">Care Coordination@(string.IsNullOrWhiteSpace(_patientName) ? "" : $" · {_patientName}")</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen" Elevation="25" ClipMode="DrawerClipMode.Never">
    <NavMenu />
</MudDrawer>

<MudMainContent>
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="min-width: 0;">
        @ChildContent
    </MudContainer>
</MudMainContent>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _drawerOpen = true;
    private string? _patientName;

    protected override async Task OnInitializedAsync()
    {
        // JWT auth here has no server-side session — a locally cached token that's
        // still unexpired will decode fine and look "logged in" client-side even if
        // the account it refers to no longer exists (e.g. the database was wiped and
        // reseeded). Confirm the account is still real before rendering as authenticated.
        try
        {
            await UsersClient.GetMeAsync(null);
        }
        catch (ApiException ex) when (ex.StatusCode is 401 or 404)
        {
            await AuthService.LogoutAsync();
            return;
        }
        catch (ApiException)
        {
            // Some other transient/network error — not evidence the session itself is invalid.
        }

        try
        {
            var settings = await SettingsClient.GetSettingsAsync(null);
            _patientName = settings.PatientName;
        }
        catch (ApiException)
        {
            // Non-fatal — the app bar just won't show the patient name.
        }

        if (await LocalStorage.GetItemAsync<bool?>("onboardingSeen") != true)
        {
            // Set before showing, not after — however the dialog gets dismissed
            // (button, Escape, backdrop click), it must never reappear.
            await LocalStorage.SetItemAsync("onboardingSeen", true);
            await DialogService.ShowAsync<OnboardingWizard>("Welcome",
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        }
    }

    private async Task Logout() => await AuthService.LogoutAsync();
}
