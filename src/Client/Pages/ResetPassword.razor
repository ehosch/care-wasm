@page "/reset-password"
@attribute [AllowAnonymous]

<div class="d-flex justify-center">
    <MudText Typo="Typo.h4" GutterBottom="true">Reset password</MudText>
</div>

@if (string.IsNullOrEmpty(_token) || string.IsNullOrEmpty(_email))
{
    <MudAlert Severity="Severity.Error">This reset link is missing required information.</MudAlert>
}
else if (_success)
{
    <MudAlert Severity="Severity.Success">
        Your password has been reset. <MudLink Href="/login">Sign in</MudLink>
    </MudAlert>
}
else
{
    <EditForm Model="this" OnValidSubmit="SubmitAsync">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="New password" Variant="Variant.Outlined" @bind-Value="_newPassword"
                    InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Confirm password" Variant="Variant.Outlined" @bind-Value="_confirmPassword"
                    InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-center">
                <MudButton ButtonType="ButtonType.Submit" Disabled="_busy" Variant="Variant.Filled"
                    Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                    Reset password
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
}
