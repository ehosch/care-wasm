@page "/calendar"
@using Care.Wasm.Client.Infrastructure.ApiClient

<PageTitle>Calendar</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Care Calendar</MudText>

<MudToolBar Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousWeekAsync" />
    <MudText Class="mx-4">@WeekRangeLabel</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextWeekAsync" />
    <MudSpacer />
    <MudButton Size="Size.Small" OnClick="GoToThisWeekAsync">This week</MudButton>
</MudToolBar>

@if (_pendingStart is not null && _pendingEnd is not null)
{
    <MudPaper Class="pa-3 mb-2" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText>@FormatRange(_pendingStart.Value, _pendingEnd.Value)</MudText>
            @if (_isCreating)
            {
                <MudText Typo="Typo.caption">Assign to</MudText>
                <MudSelect T="string" Value="@_createAssignedUserId" ValueChanged="@((string id) => _createAssignedUserId = id)"
                    Dense="true" Disabled="!_isAdmin" Style="max-width: 220px;">
                    @foreach (var user in _activeUsers)
                    {
                        <MudSelectItem Value="@user.Id">@(user.Id == _currentUserId ? "Me" : user.Name)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveAsync">Save</MudButton>
            @if (!_isCreating && _isAdmin)
            {
                <MudButton Color="Color.Error" Disabled="_busy" OnClick="DeleteAsync">Delete</MudButton>
            }
            <MudButton Disabled="_busy" OnClick="ClearPending">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div style="overflow-x: auto;">
        <table style="border-collapse: collapse; width: 100%;">
            <thead>
                <tr>
                    <th style="width: 48px;"></th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var day = _weekStart.AddDays(i);
                        <th>@day.ToString("ddd M/d")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 0; hour < 24; hour++)
                {
                    var h = hour;
                    <tr style="height: 22px;">
                        <td style="text-align:right; padding-right:4px; font-size:0.7rem; color:gray; white-space:nowrap;">@FormatHourLabel(h)</td>
                        @for (int i = 0; i < 7; i++)
                        {
                            var day = _weekStart.AddDays(i);
                            var info = GetCellInfo(day, h);
                            <td style="@CellStyle(info)" @onclick="@(() => HandleCellClick(day, h))">
                                @if (info.IsFirstHour && info.Kind == CellKind.Shift && info.Shift is not null)
                                {
                                    var shift = info.Shift;
                                    <div style="font-size:0.75rem; line-height:1.2; padding:1px 2px;">
                                        <div>@shift.AssignedUserName</div>
                                        <div style="opacity:0.7;">@FormatTimeRange(shift)</div>
                                        @if (shift.Status == ShiftStatus.Assigned && shift.AssignedUserId == _currentUserId)
                                        {
                                            <span @onclick:stopPropagation="true">
                                                <MudButton Size="Size.Small" OnClick="@(() => OpenRequestReplacementDialog(shift))">Request replacement</MudButton>
                                            </span>
                                        }
                                        else if (shift.Status == ShiftStatus.ReplacementRequested)
                                        {
                                            <div>Replacement requested</div>
                                            @if (shift.PendingReplacementRequestedByUserId == _currentUserId)
                                            {
                                                <span @onclick:stopPropagation="true">
                                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => CancelReplacementRequestAsync(shift))">Cancel request</MudButton>
                                                </span>
                                            }
                                        }
                                        <span @onclick:stopPropagation="true">
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Comment"
                                                OnClick="@(() => OpenNotesDialog(shift))" />
                                        </span>
                                        @if (shift.NoteCount > 0)
                                        {
                                            <span>@shift.NoteCount</span>
                                        }
                                        <AuthorizeView Roles="Admin" Context="authContext">
                                            <Authorized>
                                                <span @onclick:stopPropagation="true">
                                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.SwapHoriz"
                                                        OnClick="@(() => OpenReassignDialog(shift))" />
                                                </span>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
}
