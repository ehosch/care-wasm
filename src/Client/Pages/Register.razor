@page "/register"
@using Care.Wasm.Client.Infrastructure.ApiClient
@attribute [AllowAnonymous]

<div class="d-flex justify-center">
    <MudText Typo="Typo.h4" GutterBottom="true">Set up your account</MudText>
</div>

@if (string.IsNullOrEmpty(_token))
{
    <MudAlert Severity="Severity.Error">This invite link is missing a token.</MudAlert>
}
else
{
    <EditForm Model="@_model" OnValidSubmit="SubmitAsync">
        <MudGrid>
            <DataAnnotationsValidator />
            <MudItem xs="12">
                <MudTextField T="string" Label="Name" Variant="Variant.Outlined" @bind-Value="_model.Name"
                    For="@(() => _model.Name)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Password" Variant="Variant.Outlined" @bind-Value="_model.Password"
                    For="@(() => _model.Password)" InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Confirm password" Variant="Variant.Outlined" @bind-Value="_confirmPassword"
                    InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Phone number (optional, for SMS notifications)" Variant="Variant.Outlined"
                    @bind-Value="_model.PhoneNumber" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_smsConsent" Color="Color.Primary">
                    Yes, I'd like to receive automated SMS notifications about my caregiving shifts
                    (shift assignments, replacement requests, document uploads) from Care
                    Coordination. Message frequency varies with shift activity. Message and data
                    rates may apply. Reply HELP for help, STOP to cancel at any time.
                    <MudLink Href="/terms" Target="_blank">Terms</MudLink>
                    &middot; <MudLink Href="/privacy" Target="_blank">Privacy Policy</MudLink>.
                </MudCheckBox>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-center">
                <MudButton ButtonType="ButtonType.Submit" Disabled="_busy" Variant="Variant.Filled"
                    Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                    Create account
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
}
