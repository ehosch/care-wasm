@page "/forgot-password"
@attribute [AllowAnonymous]

<div class="d-flex justify-center">
    <MudText Typo="Typo.h4" GutterBottom="true">Forgot password</MudText>
</div>

@if (_submitted)
{
    <MudAlert Severity="Severity.Success">
        If an account exists for that email, a password reset link has been sent.
    </MudAlert>
}
else
{
    <EditForm Model="this" OnValidSubmit="SubmitAsync">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_email" />
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-center">
                <MudButton ButtonType="ButtonType.Submit" Disabled="_busy" Variant="Variant.Filled"
                    Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                    Send reset link
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}
