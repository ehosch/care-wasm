@page "/confirm-email-change"
@attribute [AllowAnonymous]

<div class="d-flex justify-center">
    <MudText Typo="Typo.h4" GutterBottom="true">Confirm email change</MudText>
</div>

@if (string.IsNullOrEmpty(_userId) || string.IsNullOrEmpty(_newEmail) || string.IsNullOrEmpty(_token))
{
    <MudAlert Severity="Severity.Error">This confirmation link is missing required information.</MudAlert>
}
else if (_success)
{
    <MudAlert Severity="Severity.Success">
        Your email has been updated to @_newEmail. <MudLink Href="/login">Sign in</MudLink>
    </MudAlert>
}
else
{
    <div class="d-flex justify-center">
        <MudText Class="mb-4">Confirm changing your email to <b>@_newEmail</b>?</MudText>
    </div>
    <div class="d-flex justify-center">
        <MudButton Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="SubmitAsync">
            Confirm
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
}
