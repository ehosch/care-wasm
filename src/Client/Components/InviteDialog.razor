@using Care.Wasm.Client.Infrastructure.ApiClient

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Email (optional if phone number is provided)" Variant="Variant.Outlined" @bind-Value="_email" />
        <MudTextField T="string" Label="Phone number (optional if email is provided; sends the invite via text)" Variant="Variant.Outlined"
            Class="mt-4" @bind-Value="_phoneNumber" />
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SubmitAsync">Send Invite</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private IUsersClient UsersClient { get; set; } = default!;

    private string _email = string.Empty;
    private string _phoneNumber = string.Empty;
    private bool _busy;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_email) && string.IsNullOrWhiteSpace(_phoneNumber))
        {
            _errorMessage = "Provide an email or phone number.";
            return;
        }

        _busy = true;
        try
        {
            string? email = string.IsNullOrWhiteSpace(_email) ? null : _email;
            string? phoneNumber = string.IsNullOrWhiteSpace(_phoneNumber) ? null : _phoneNumber;
            await UsersClient.InviteAsync(null, new CreateInviteRequest { Email = email, PhoneNumber = phoneNumber });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _errorMessage = ApiErrorHelper.GetFriendlyMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
