@using Care.Wasm.Client.Infrastructure.ApiClient

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_email" />
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SubmitAsync">Send Invite</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private IUsersClient UsersClient { get; set; } = default!;

    private string _email = string.Empty;
    private bool _busy;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _busy = true;
        _errorMessage = null;
        try
        {
            await UsersClient.InviteAsync(null, new CreateInviteRequest { Email = _email });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
